{
  "name": "omni-doc-viewer",
  "version": "0.2.0",
  "description": "One <DocViewer> for PDF, Word, Excel & PowerPoint. 100% client-side — no server, no Microsoft iframe, no public-URL requirement, no API keys.",
  "license": "MIT",
  "author": "akbhuker <akbhuker49@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akbhuker/omni-doc-viewer.git"
  },
  "homepage": "https://akbhuker.github.io/omni-doc-viewer/",
  "bugs": {
    "url": "https://github.com/akbhuker/omni-doc-viewer/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "keywords": [
    "pdf",
    "pdf-viewer",
    "docx",
    "docx-viewer",
    "word-viewer",
    "xlsx",
    "xls",
    "excel-viewer",
    "spreadsheet-viewer",
    "pptx",
    "powerpoint-viewer",
    "image-viewer",
    "markdown-viewer",
    "markdown",
    "csv-viewer",
    "csv",
    "text-viewer",
    "document",
    "document-viewer",
    "doc-viewer",
    "file-viewer",
    "office",
    "office-viewer",
    "viewer",
    "preview",
    "react",
    "react-component",
    "browser",
    "client-side",
    "no-server",
    "offline"
  ],
  "files": [
    "dist",
    "NOTICE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "dev:demo": "pnpm --filter omni-doc-viewer-demo dev",
    "samples": "node scripts/make-samples.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit --project dom",
    "test:watch": "vitest --project unit --project dom",
    "lint": "eslint .",
    "verify": "pnpm lint && pnpm typecheck && pnpm test",
    "commitlint": "commitlint --edit",
    "prepare": "husky || true",
    "prepublishOnly": "pnpm build",
    "test:browser": "vitest run --project browser",
    "fixtures": "node scripts/make-fixtures.mjs"
  },
  "dependencies": {
    "@e965/xlsx": "0.20.3",
    "docx-preview": "^0.4.0",
    "dompurify": "^3.4.14",
    "emf-converter": "^2.0.2",
    "jszip": "^3.10.1",
    "marked": "^18.0.11",
    "pdfjs-dist": "^6.3.289",
    "pptx-preview": "^1.0.7"
  },
  "peerDependencies": {
    "react": ">=17",
    "react-dom": ">=17"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitest/browser-playwright": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "happy-dom": "^20.12.0",
    "husky": "^9.1.7",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.20.2",
    "playwright": "^1.62.1",
    "pptxgenjs": "^4.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "echarts": ">=6.1.0",
      "uuid": ">=11.1.1"
    }
  }
}
